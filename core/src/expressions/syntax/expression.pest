// Action Expressions Syntax Grammar - v1
action = {
	 SOI ~ (text | expression | unclosed)* ~ EOI
}

text = @{ wild_char+ }
wild_char = { !expression ~ !opener ~ ANY }

opener = _{ ("#" | "$" | "@") ~ "[" }

unclosed = @{ opener ~ char* }

expression = _{
    (action_call | local_call
    | argument_call)
}

action_call = {
    "#" ~ "[" ~ id ~ "]" ~ arguments?
}

arguments = _{
	"("
    ~ (WS* ~ argument ~ WS* ~ ","?)*
    ~ ")"
}
argument = { expression | string }

local_call = {
	"$" ~ "[" ~ id ~ "]"
}

argument_call = {
	"@" ~ "[" ~ id ~ "]"
}


id = { char+ }
string = { "\"" ~ value ~ "\"" }
value = { (!"\"" ~ ANY)* }
char = _{ ASCII_ALPHANUMERIC | "_" | "-" | "!" }

WS = _{ " " | "\t" | "\r" | "\n" }
// WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

