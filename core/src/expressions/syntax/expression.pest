// Action Expressions Syntax Grammar - v1
action = {
	 SOI ~ (text | expression | unclosed)* ~ EOI
}

text = @{ (!opener ~ ANY)+ }

opener = _{ ("#" | "$" | "@") ~ "[" }

unclosed = @{ opener ~ char* }

expression = _{
    (action_call | local_call
    | argument_call)
}

action_call = {
    "#" ~ "[" ~ call_id ~ arguments? ~ "]"
}

arguments = _{
	"("
    ~ WS* ~ (argument ~ (WS* ~ "," ~ WS* ~ argument)*)? ~ WS*
    ~ ")"
}
argument = _{ expression | number | single | double }

local_call = {
	"$" ~ "[" ~ id ~ "]"
}

argument_call = {
	"@" ~ "[" ~ id ~ "]"
}


id = { char+ }
call_id = { char+ ~ ("." ~ char+)* }
number = @{ ASCII_DIGIT+ }
single = { "'" ~ (single_text | expression)* ~ "'" }
single_text = @{ (!"'" ~ !opener ~ ANY)+ }
double = { "\"" ~ (double_text | expression)* ~ "\"" }
double_text = @{ (!"\"" ~ !opener ~ ANY)+ }
char = _{ ASCII_ALPHANUMERIC | "_" | "-" | "!" }

WS = _{ " " | "\t" | "\r" | "\n" }
// WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
