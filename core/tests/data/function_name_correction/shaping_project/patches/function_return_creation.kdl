enabled true
alias "cpp"
file "ReturnModule.cpp"

actions {
    builder "function_header_builder" {
        location "function_definition.body"
        reference-location "function_definition"
        match r"void Method(\w+)\("
        build "#[function_type_builder] Method$[0]"
        actions {
            builder "function_type_builder" {
                location "function_definition.body"
                match r#"std::string type = "(.+?)";"#
                build "#[function_type_switch]($[0])"
            }

            switch "function_type_switch" {
                index "@[0]"
                cases integer="int" boolean="bool"
            }
        }
    }

    replacer {
        location "function_definition.body"
        reference-location "function_definition"
        from r"void Method\w+"
        to "#[function_header_builder]"
    }

    replacer {
        location "function_definition.body"
        from r"(int (\w+) = \d+;)\n\}"
        to "$[0]\n\t\n\treturn $[1];\n}"
    }
}
