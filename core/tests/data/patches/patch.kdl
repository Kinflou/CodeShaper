enabled true
alias "text"
file "test.txt"

actions {
    builders {
        builder "hello_builder" {
            location "*"
            match "Lets greet (.+)!"
            build "Hello #[code_maker]($[0]) World!"
        }
    }
    makers {
        maker "code_maker" {
            make "@[0] Library"
        }
    }
}

