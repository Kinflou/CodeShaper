{
  "name": "codeshaper",
  "displayName": "CodeShaper",
  "description": "Diagnostics, completion and navigation for CodeShaper patches",
  "version": "0.1.0",
  "publisher": "kinflou",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "repository": "https://github.com/Kinflou/CodeShaper",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:kdl",
    "workspaceContains:**/project.kdl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kdl",
        "aliases": [
          "KDL",
          "kdl"
        ],
        "extensions": [
          ".kdl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "codeshaper-query"
      }
    ],
    "grammars": [
      {
        "language": "kdl",
        "scopeName": "source.kdl.codeshaper",
        "path": "./syntaxes/kdl.tmLanguage.json"
      },
      {
        "language": "codeshaper-query",
        "scopeName": "source.query.codeshaper",
        "path": "./syntaxes/query.tmLanguage.json"
      },
      {
        "scopeName": "codeshaper.expressions.injection",
        "path": "./syntaxes/expressions.tmLanguage.json",
        "injectTo": [
          "source.kdl.codeshaper"
        ]
      },
      {
        "scopeName": "codeshaper.fields.injection",
        "path": "./syntaxes/fields.tmLanguage.json",
        "injectTo": [
          "source.kdl.codeshaper"
        ]
      }
    ],
    "commands": [
      {
        "command": "codeshaper.preview",
        "title": "Preview Patch Result",
        "category": "CodeShaper",
        "icon": {
          "light": "images/preview-light.png",
          "dark": "images/preview-dark.png"
        }
      },
      {
        "command": "codeshaper.previewOperation",
        "title": "Preview Operation Result",
        "category": "CodeShaper",
        "icon": {
          "light": "images/preview-light.png",
          "dark": "images/preview-dark.png"
        }
      },
      {
        "command": "codeshaper.explore",
        "title": "Explore Target",
        "category": "CodeShaper",
        "icon": "$(telescope)"
      },
      {
        "command": "codeshaper.nextPlace",
        "title": "Next Place of the Location",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.previousPlace",
        "title": "Previous Place of the Location",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.allPlaces",
        "title": "All Places of the Location",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.highlightBlock",
        "title": "Select the Block",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.exploreParent",
        "title": "Select the Surrounding Block",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.copyLocation",
        "title": "Copy Location",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.exploreChild",
        "title": "Select a Block Inside",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.toggleHighlights",
        "title": "Highlight the Block and its Places",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.toggleHints",
        "title": "Show or Hide Every Hint",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.editExplored",
        "title": "Edit the Explored File",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.exploreKeys",
        "title": "Keys While Exploring",
        "category": "CodeShaper"
      },
      {
        "command": "codeshaper.setVariable",
        "title": "Set Value",
        "category": "CodeShaper",
        "icon": "$(edit)"
      },
      {
        "command": "codeshaper.resetVariable",
        "title": "Remove the Value Set Here",
        "category": "CodeShaper",
        "icon": "$(discard)"
      },
      {
        "command": "codeshaper.openVariable",
        "title": "Go to Declaration",
        "category": "CodeShaper"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeshaper",
          "title": "CodeShaper",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "codeshaper": [
        {
          "id": "codeshaper.variables",
          "name": "Variables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeshaper.variables",
        "contents": "No CodeShaper projects found in this workspace. Projects that git ignores are left out.",
        "when": "codeshaper.searched"
      }
    ],
    "keybindings": [
      {
        "command": "codeshaper.nextPlace",
        "key": "n",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "codeshaper.previousPlace",
        "key": "p",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "codeshaper.allPlaces",
        "key": "a",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "codeshaper.exploreParent",
        "key": "u",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "codeshaper.exploreChild",
        "key": "d",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "codeshaper.toggleHighlights",
        "key": "s",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "codeshaper.toggleHints",
        "key": "h",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "editor.action.showHover",
        "key": "i",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "codeshaper.copyLocation",
        "key": "c",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      },
      {
        "command": "codeshaper.editExplored",
        "key": "e",
        "when": "codeshaper.exploring && editorTextFocus && resourceScheme == codeshaper-explore"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "codeshaper.setVariable",
          "when": "view == codeshaper.variables && viewItem =~ /^(variable|set)$/",
          "group": "inline@1"
        },
        {
          "command": "codeshaper.resetVariable",
          "when": "view == codeshaper.variables && viewItem =~ /^(set|unknown)$/",
          "group": "inline@2"
        },
        {
          "command": "codeshaper.setVariable",
          "when": "view == codeshaper.variables && viewItem =~ /^(variable|set)$/",
          "group": "1_value@1"
        },
        {
          "command": "codeshaper.resetVariable",
          "when": "view == codeshaper.variables && viewItem =~ /^(set|unknown)$/",
          "group": "1_value@2"
        },
        {
          "command": "codeshaper.openVariable",
          "when": "view == codeshaper.variables && viewItem =~ /^(constant|variable|set)$/",
          "group": "2_open"
        }
      ],
      "editor/title": [
        {
          "command": "codeshaper.preview",
          "when": "resourceLangId == kdl && resourcePath =~ /[\\\\/]patches[\\\\/]/",
          "group": "navigation"
        },
        {
          "command": "codeshaper.previewOperation",
          "when": "resourceLangId == kdl && resourceFilename == configuration.kdl",
          "group": "navigation"
        },
        {
          "command": "codeshaper.explore",
          "when": "resourceLangId == kdl && resourcePath =~ /[\\\\/]patches[\\\\/]/",
          "group": "navigation"
        },
        {
          "command": "codeshaper.explore",
          "when": "resourceLangId == kdl && resourceFilename == configuration.kdl",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codeshaper.preview",
          "when": "editorLangId == kdl"
        },
        {
          "command": "codeshaper.previewOperation",
          "when": "editorLangId == kdl"
        },
        {
          "command": "codeshaper.explore",
          "when": "editorLangId == kdl"
        },
        {
          "command": "codeshaper.nextPlace",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.previousPlace",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.allPlaces",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.highlightBlock",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.exploreParent",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.copyLocation",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.exploreChild",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.toggleHighlights",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.toggleHints",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.editExplored",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.exploreKeys",
          "when": "codeshaper.exploring"
        },
        {
          "command": "codeshaper.setVariable",
          "when": "false"
        },
        {
          "command": "codeshaper.resetVariable",
          "when": "false"
        },
        {
          "command": "codeshaper.openVariable",
          "when": "false"
        }
      ]
    },
    "configurationDefaults": {
      "[kdl]": {
        "editor.inlayHints.fontSize": 11
      }
    },
    "configuration": {
      "title": "CodeShaper",
      "properties": {
        "codeshaper.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the codeshaper executable, started as `codeshaper lsp`. When empty, the one included with the extension is used, or `codeshaper` on the PATH if there is none."
        },
        "codeshaper.hover.samples": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "How many sample results hovers show."
        },
        "codeshaper.hover.lines": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "description": "Lines kept from each hover sample before it is cut, and from a block's code while exploring."
        },
        "codeshaper.hover.characters": {
          "type": "integer",
          "default": 400,
          "minimum": 1,
          "description": "Characters kept from each hover sample before it is cut, and from a block's code while exploring."
        },
        "codeshaper.inlayHints.groups": {
          "type": "boolean",
          "default": false,
          "description": "Show each capture group's number before it. Takes effect after reloading the window."
        },
        "codeshaper.inlayHints.matches": {
          "type": "boolean",
          "default": true,
          "description": "Show how many places each location matches, and how often each action matches, builds and is called. Updated on open and save. Takes effect after reloading the window."
        },
        "codeshaper.explore.depth": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "description": "How many levels of blocks of several lines get a hint while exploring. 0 turns the hints off."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.9.3"
  }
}
