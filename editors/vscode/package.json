{
  "name": "codeshaper",
  "displayName": "CodeShaper",
  "description": "Diagnostics, completion and navigation for CodeShaper patches",
  "version": "0.1.0",
  "publisher": "kinflou",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": "https://github.com/Kinflou/CodeShaper",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": [
    "onLanguage:kdl",
    "workspaceContains:**/settings.kdl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kdl",
        "aliases": [
          "KDL",
          "kdl"
        ],
        "extensions": [
          ".kdl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kdl",
        "scopeName": "source.kdl.codeshaper",
        "path": "./syntaxes/kdl.tmLanguage.json"
      },
      {
        "scopeName": "codeshaper.expressions.injection",
        "path": "./syntaxes/expressions.tmLanguage.json",
        "injectTo": [
          "source.kdl.codeshaper"
        ]
      }
    ],
    "commands": [
      {
        "command": "codeshaper.preview",
        "title": "CodeShaper: Preview Patch Result",
        "icon": {
          "light": "images/preview-light.png",
          "dark": "images/preview-dark.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codeshaper.preview",
          "when": "resourceLangId == kdl && resourcePath =~ /[\\\\/]patches[\\\\/]/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codeshaper.preview",
          "when": "editorLangId == kdl"
        }
      ]
    },
    "configuration": {
      "title": "CodeShaper",
      "properties": {
        "codeshaper.server.path": {
          "type": "string",
          "default": "codeshaper",
          "description": "Path to the codeshaper executable, started as `codeshaper lsp`."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.91.0",
    "typescript": "^5.9.3"
  }
}
