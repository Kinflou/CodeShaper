{
    "scopeName": "codeshaper.fields.injection",
    "injectionSelector": "L:source.kdl.codeshaper -string -comment",
    "patterns": [
        {
            "include": "#raw-query"
        },
        {
            "include": "#quoted-query"
        }
    ],
    "repository": {
        "raw-query": {
            "begin": "(?<![\\w-])((?:reference-)?location)([ \\t]+)(r(#*)\")",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.tag"
                },
                "3": {
                    "name": "punctuation.definition.string.begin.kdl"
                }
            },
            "end": "\"\\4",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.kdl"
                }
            },
            "contentName": "string.quoted.double.raw.kdl meta.embedded.query.codeshaper",
            "patterns": [
                {
                    "include": "#query"
                }
            ]
        },
        "quoted-query": {
            "begin": "(?<![\\w-])((?:reference-)?location)([ \\t]+)(\")(?=\\s*\\()",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.tag"
                },
                "3": {
                    "name": "punctuation.definition.string.begin.kdl"
                }
            },
            "end": "\"",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.kdl"
                }
            },
            "contentName": "string.quoted.double.query.kdl meta.embedded.query.codeshaper",
            "patterns": [
                {
                    "include": "#query"
                }
            ]
        },
        "query": {
            "patterns": [
                {
                    "match": ";.*?(?=\"|$)",
                    "name": "comment.line.semicolon.query.codeshaper"
                },
                {
                    "match": "\\\\\"(?:[^\"\\\\]|\\\\[^\"])*\\\\\"",
                    "name": "string.quoted.single.query.codeshaper"
                },
                {
                    "match": "\"(?:[^\"\\\\]|\\\\.)*\"(?!#)",
                    "name": "string.quoted.single.query.codeshaper"
                },
                {
                    "match": "(#)([A-Za-z0-9_.-]+[?!]?)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.predicate.query.codeshaper"
                        },
                        "2": {
                            "name": "support.function.predicate.query.codeshaper"
                        }
                    }
                },
                {
                    "match": "(@)([A-Za-z0-9_.-]+)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.capture.query.codeshaper"
                        },
                        "2": {
                            "name": "variable.parameter.capture.query.codeshaper"
                        }
                    }
                },
                {
                    "match": "!?[A-Za-z_][A-Za-z0-9_-]*(?=\\s*:)",
                    "name": "variable.other.property.field.query.codeshaper"
                },
                {
                    "match": "![A-Za-z_][A-Za-z0-9_-]*",
                    "name": "variable.other.property.field.query.codeshaper"
                },
                {
                    "match": "(?<![\\w.])_(?!\\w)",
                    "name": "variable.language.wildcard.query.codeshaper"
                },
                {
                    "match": "(?<=[\\s(/]|^)[A-Za-z_][A-Za-z0-9_-]*",
                    "name": "entity.name.type.node.query.codeshaper"
                },
                {
                    "match": "[*+?](?=[\\s)\\]]|$)",
                    "name": "keyword.operator.quantifier.query.codeshaper"
                },
                {
                    "match": "[()\\[\\]]",
                    "name": "punctuation.section.query.codeshaper"
                }
            ]
        }
    }
}
